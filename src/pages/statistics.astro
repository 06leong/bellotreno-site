            <details class="statistics-methodology" data-analytics-topic-panel="quality" hidden>
                <summary>
                    <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                    <span data-i18n="statistics_methodology_title">Definitions and data quality</span>
                </summary>
                <div class="statistics-methodology-grid">
                    <div><strong data-i18n="statistics_method_punctuality_title">Arrival punctuality</strong><p data-i18n="statistics_method_punctuality_detail">Completed, canonical services with a final observed arrival; thresholds are at most 5 and 15 minutes.</p></div>
                    <div><strong data-i18n="statistics_method_cancel_title">Cancellation</strong><p data-i18n="statistics_method_cancel_detail">Observed full-service cancellations divided by services with a reliable completed-or-cancelled outcome.</p></div>
                    <div><strong data-i18n="statistics_method_missing_title">Missing evidence</strong><p data-i18n="statistics_method_missing_detail">Provider failures, unresolved identities and unfinished services are excluded, never converted to zero or cancellation.</p></div>
                    <div><strong data-i18n="statistics_method_scope_title">Scope</strong><p data-i18n="statistics_method_scope_detail">Results describe the ViaggiaTreno services BelloTreno could observe; they are not official whole-network statistics.</p></div>
                </div>
            </details>
