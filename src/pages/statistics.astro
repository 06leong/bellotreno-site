---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Statistiche ferroviarie italiane - BelloTreno"
    description="Statistiche giornaliere dei treni italiani monitorati da BelloTreno: puntualita, ritardi, cancellazioni, categorie e andamento della circolazione.">
    <Fragment slot="head"></Fragment>
    <Fragment slot="scripts">
        <script>
            import '../client/statistics.ts';
            import '../client/statistics-analytics.ts';
        </script>
    </Fragment>

    <main class="statistics-page container">
        <header class="statistics-header">
            <div class="statistics-heading">
                <p class="statistics-kicker" data-i18n="statistics_kicker">ViaggiaTreno observable data</p>
                <h1 data-i18n="statistics_title">Railway Statistics</h1>
                <p data-i18n="statistics_subtitle">Daily operational statistics based on trains visible through ViaggiaTreno.</p>
                <div class="statistics-mode-switch" role="tablist" aria-label="Statistics mode">
                    <button id="statisticsModeLive" class="statistics-mode-button active" type="button" role="tab" aria-selected="true" data-statistics-mode="live">
                        <span class="material-symbols-outlined" aria-hidden="true">sensors</span>
                        <span data-i18n="statistics_mode_live">Live operations</span>
                    </button>
                    <button id="statisticsModePerformance" class="statistics-mode-button" type="button" role="tab" aria-selected="false" data-statistics-mode="performance">
                        <span class="material-symbols-outlined" aria-hidden="true">analytics</span>
                        <span data-i18n="statistics_mode_performance">Historical performance</span>
                    </button>
                </div>
            </div>

            <div id="statisticsLiveControls" class="statistics-controls" aria-label="Statistics date controls">
                <label class="statistics-date-field">
                    <span data-i18n="statistics_date">Date</span>
                    <span class="statistics-select-shell">
                        <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                        <select id="statisticsDate" class="select select-bordered"></select>
                    </span>
                </label>
                <label class="statistics-date-field">
                    <span data-i18n="statistics_compare_date">Compare date</span>
                    <span class="statistics-select-shell">
                        <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                        <select id="statisticsCompareDate" class="select select-bordered" disabled>
                            <option value="" data-i18n="statistics_no_comparable_day">No comparable complete day</option>
                        </select>
                    </span>
                </label>
                <button id="statisticsLatestComplete" class="statistics-latest-complete" type="button" hidden>
                    <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                    <span data-i18n="statistics_view_latest_complete">View latest complete day</span>
                </button>
            </div>
        </header>

        <div id="statisticsLiveView">
        <section id="statisticsStatus" class="statistics-status" aria-live="polite" hidden></section>

        <section class="statistics-context-rail" aria-label="Data freshness and coverage">
            <div id="statisticsCoverageNotice" class="statistics-coverage-notice" aria-live="polite">
                <span class="material-symbols-outlined" aria-hidden="true">info</span>
                <span data-i18n="statistics_coverage_loading">Checking detailed-data coverage...</span>
            </div>

            <div class="statistics-meta-row">
                <div class="statistics-meta-item">
                    <span class="material-symbols-outlined" aria-hidden="true">update</span>
                    <span data-i18n="statistics_last_updated">Last updated</span>
                    <strong id="statisticsLastUpdated">--</strong>
                </div>
                <div class="statistics-meta-item">
                    <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
                    <span data-i18n="statistics_cadence">Sampling</span>
                    <strong id="statisticsCadence">--</strong>
                </div>
                <div class="statistics-meta-item">
                    <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
                    <span data-i18n="statistics_coverage">Coverage</span>
                    <strong id="statisticsCoverage">--</strong>
                </div>
            </div>
        </section>

        <section class="statistics-summary-strip" aria-label="Daily summary">
            <div id="statisticsMetrics" class="statistics-metrics" aria-live="polite"></div>
            <aside id="statisticsComparisonStatus" class="statistics-comparison-status" aria-live="polite">
                <span class="material-symbols-outlined" aria-hidden="true">monitoring</span>
                <div>
                    <strong data-i18n="statistics_comparison_pending">Daily comparison is not available yet</strong>
                    <span data-i18n="statistics_comparison_pending_detail">A complete comparison date is required.</span>
                </div>
            </aside>
        </section>

        <nav id="statisticsAnalysisTabs" class="statistics-analysis-tabs" aria-label="Statistics analysis" role="tablist">
            <button type="button" class="statistics-analysis-tab active" role="tab" aria-selected="true" data-analysis-view="overview" data-i18n="statistics_analysis_overview">Overview</button>
            <button type="button" class="statistics-analysis-tab" role="tab" aria-selected="false" data-analysis-view="trends" data-i18n="statistics_analysis_trends">Trends</button>
            <button type="button" class="statistics-analysis-tab" role="tab" aria-selected="false" data-analysis-view="network" data-i18n="statistics_analysis_network">Stations &amp; routes</button>
            <button type="button" class="statistics-analysis-tab" role="tab" aria-selected="false" data-analysis-view="details" data-i18n="statistics_analysis_details">Data details</button>
        </nav>

        <section class="statistics-primary-grid">
            <article class="statistics-panel statistics-trend-panel">
                <div class="statistics-panel-head">
                    <div>
                        <span class="statistics-panel-kicker" data-i18n="statistics_analysis_overview">Overview</span>
                        <h2 data-i18n="statistics_chart_running">Trains in circulation</h2>
                    </div>
                </div>
                <div id="statisticsRunningChart" class="statistics-chart-box statistics-chart-box-primary" role="img" aria-label="Trains in circulation over the selected day"></div>
            </article>

            <aside class="statistics-panel statistics-insights-panel">
                <div class="statistics-panel-head">
                    <div>
                        <span class="statistics-panel-kicker" data-i18n="statistics_analysis_attention">Operational attention</span>
                        <h2 data-i18n="statistics_insights_title">Needs attention</h2>
                    </div>
                </div>
                <div id="statisticsInsights" class="statistics-insights" aria-live="polite">
                    <div class="statistics-insights-empty">
                        <span class="material-symbols-outlined" aria-hidden="true">fact_check</span>
                        <p data-i18n="statistics_insights_empty">Insights will appear when enough data is available.</p>
                    </div>
                </div>
            </aside>
        </section>

        <section class="statistics-analysis-grid" aria-label="Supporting analysis">
            <article class="statistics-panel">
                <div class="statistics-panel-head">
                    <div>
                        <span class="statistics-panel-kicker" data-i18n="statistics_analysis_reliability">Reliability</span>
                        <h2 data-i18n="statistics_chart_regular">Regularity</h2>
                    </div>
                </div>
                <div id="statisticsRegularityChart" class="statistics-chart-box" role="img" aria-label="Observed train outcomes"></div>
            </article>
            <article class="statistics-panel">
                <div class="statistics-panel-head">
                    <div>
                        <span class="statistics-panel-kicker" data-i18n="statistics_analysis_punctuality">Arrival and departure</span>
                        <h2 data-i18n="statistics_chart_punctuality">Punctuality</h2>
                    </div>
                </div>
                <div id="statisticsPunctualityChart" class="statistics-chart-box" role="img" aria-label="Arrival and departure punctuality"></div>
            </article>
            <article class="statistics-panel">
                <div class="statistics-panel-head">
                    <div>
                        <span class="statistics-panel-kicker" data-i18n="statistics_analysis_mix">Service mix</span>
                        <h2 data-i18n="statistics_chart_categories">Categories</h2>
                    </div>
                </div>
                <div id="statisticsCategoryChart" class="statistics-chart-box" role="img" aria-label="Observed trains by service category"></div>
            </article>
        </section>

        <section class="statistics-panel statistics-search-panel">
            <div class="statistics-panel-head statistics-query-head">
                <div>
                    <span class="statistics-panel-kicker" data-i18n="statistics_filters_title">Filter and inspect</span>
                    <h2 data-i18n="statistics_query_title">Explore statistics</h2>
                </div>
                <button id="statisticsCsv" class="statistics-export-button" type="button" hidden>
                    <span class="material-symbols-outlined" aria-hidden="true">download</span>
                    <span data-i18n="statistics_export_csv">Export CSV</span>
                </button>
            </div>

            <div class="statistics-tabs" role="tablist" aria-label="Statistics data view">
                <button type="button" class="statistics-tab active" role="tab" aria-selected="true" data-stat-view="trains" data-i18n="statistics_tab_trains">Trains</button>
                <button type="button" class="statistics-tab" role="tab" aria-selected="false" data-stat-view="stations" data-i18n="statistics_tab_stations">Stations</button>
                <button type="button" class="statistics-tab" role="tab" aria-selected="false" data-stat-view="relations" data-i18n="statistics_tab_relations">Relations</button>
                <button type="button" class="statistics-tab" role="tab" aria-selected="false" data-stat-view="ranking" data-i18n="statistics_tab_ranking">Ranking</button>
            </div>

            <div class="statistics-filter-grid">
                <label class="statistics-filter-field statistics-filter-search">
                    <span class="statistics-visually-hidden" data-i18n="statistics_search_placeholder">Search train, station or relation</span>
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input id="statisticsSearch" class="input input-bordered" type="search" autocomplete="off" data-i18n="statistics_search_placeholder" placeholder="Search train, station or relation">
                </label>
                <label class="statistics-filter-field">
                    <span class="statistics-visually-hidden" data-i18n="statistics_all_categories">All categories</span>
                    <select id="statisticsCategory" class="select select-bordered">
                        <option value="" data-i18n="statistics_all_categories">All categories</option>
                    </select>
                </label>
                <label class="statistics-filter-field">
                    <span class="statistics-visually-hidden" data-i18n="statistics_all_statuses">All statuses</span>
                    <select id="statisticsStatusFilter" class="select select-bordered">
                        <option value="" data-i18n="statistics_all_statuses">All statuses</option>
                        <option value="regular" data-i18n="statistics_status_regular">Regular</option>
                        <option value="delayed" data-i18n="statistics_status_delayed">Delayed</option>
                        <option value="not_departed" data-i18n="statistics_status_not_departed">Not Departed</option>
                        <option value="cancelled" data-i18n="statistics_status_cancelled">Cancelled</option>
                        <option value="rescheduled" data-i18n="statistics_status_rescheduled">Rescheduled</option>
                    </select>
                </label>
            </div>

            <div id="statisticsTableStatus" class="statistics-table-status" aria-live="polite"></div>
            <div class="statistics-table-wrap">
                <table class="statistics-table">
                    <thead id="statisticsTableHead"></thead>
                    <tbody id="statisticsTableBody"></tbody>
                </table>
            </div>
            <div class="statistics-pagination">
                <button id="statisticsPrev" class="btn btn-sm" type="button">
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                    <span data-i18n="statistics_prev">Previous</span>
                </button>
                <span id="statisticsPageInfo">--</span>
                <button id="statisticsNext" class="btn btn-sm" type="button">
                    <span data-i18n="statistics_next">Next</span>
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                </button>
            </div>
        </section>
        </div>

        <section id="statisticsPerformanceView" class="statistics-performance" aria-labelledby="statisticsPerformanceTitle" hidden>
            <div class="statistics-performance-toolbar">
                <div>
                    <p class="statistics-panel-kicker" data-i18n="statistics_performance_kicker">Comparable service outcomes</p>
                    <h2 id="statisticsPerformanceTitle" data-i18n="statistics_performance_title">Network performance</h2>
                    <p data-i18n="statistics_performance_subtitle">Completed service days, explicit denominators and tail-delay indicators.</p>
                </div>
                <button id="statisticsAnalyticsExport" class="statistics-export-button" type="button" hidden>
                    <span class="material-symbols-outlined" aria-hidden="true">download</span>
                    <span data-i18n="statistics_export_analysis_csv">Export analysis CSV</span>
                </button>
            </div>

            <div class="statistics-performance-filters" aria-label="Historical analysis filters">
                <fieldset class="statistics-window-control">
                    <legend data-i18n="statistics_window">Analysis window</legend>
                    <div class="statistics-window-options">
                        <button type="button" data-analytics-window="7">7 <span data-i18n="statistics_days_short">days</span></button>
                        <button type="button" class="active" data-analytics-window="28">28 <span data-i18n="statistics_days_short">days</span></button>
                        <button type="button" data-analytics-window="90">90 <span data-i18n="statistics_days_short">days</span></button>
                    </div>
                </fieldset>
                <label class="statistics-performance-field">
                    <span data-i18n="statistics_as_of_date">As of service date</span>
                    <select id="statisticsAnalyticsAsOf" class="select select-bordered"></select>
                </label>
                <label class="statistics-performance-field">
                    <span data-i18n="statistics_filter_operator">Operator</span>
                    <select id="statisticsAnalyticsOperator" class="select select-bordered">
                        <option value="" data-i18n="statistics_all_operators">All operators</option>
                    </select>
                </label>
                <label class="statistics-performance-field">
                    <span data-i18n="statistics_filter_category">Category</span>
                    <select id="statisticsAnalyticsCategory" class="select select-bordered">
                        <option value="" data-i18n="statistics_all_categories">All categories</option>
                    </select>
                </label>
            </div>

            <section id="statisticsAnalyticsStatus" class="statistics-status statistics-status-info" aria-live="polite">
                <span data-i18n="statistics_analytics_loading">Preparing historical analysis...</span>
            </section>

            <section class="statistics-quality-rail" aria-label="Analytics freshness and quality">
                <div class="statistics-quality-summary">
                    <span class="material-symbols-outlined" aria-hidden="true">verified</span>
                    <div>
                        <strong id="statisticsAnalyticsCoverage" data-i18n="statistics_analytics_quality_pending">Checking comparable days</strong>
                        <span id="statisticsAnalyticsCoverageDetail">--</span>
                    </div>
                </div>
                <div class="statistics-quality-facts">
                    <div><span data-i18n="statistics_data_as_of">Data as of</span><strong id="statisticsAnalyticsFreshness">--</strong></div>
                    <div><span data-i18n="statistics_metric_version">Metric definition</span><strong id="statisticsAnalyticsMetricVersion">--</strong></div>
                    <div><span data-i18n="statistics_observed_services">Observed services</span><strong id="statisticsAnalyticsObserved">--</strong></div>
                </div>
            </section>

            <section id="statisticsAnalyticsMetrics" class="statistics-performance-metrics" aria-label="Historical performance indicators"></section>

            <nav id="statisticsAnalyticsTopics" class="statistics-analytics-topics" aria-label="Historical analysis topics" role="tablist">
                <button type="button" class="active" role="tab" aria-selected="true" data-analytics-topic="overview">
                    <span class="material-symbols-outlined" aria-hidden="true">monitoring</span>
                    <span data-i18n="statistics_topic_overview">Overview</span>
                </button>
                <button type="button" role="tab" aria-selected="false" data-analytics-topic="mix">
                    <span class="material-symbols-outlined" aria-hidden="true">donut_large</span>
                    <span data-i18n="statistics_topic_mix">Service mix</span>
                </button>
                <button type="button" role="tab" aria-selected="false" data-analytics-topic="rhythm">
                    <span class="material-symbols-outlined" aria-hidden="true">date_range</span>
                    <span data-i18n="statistics_topic_rhythm">Network rhythm</span>
                </button>
                <button type="button" role="tab" aria-selected="false" data-analytics-topic="stations">
                    <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
                    <span data-i18n="statistics_topic_stations">Stations</span>
                </button>
                <button type="button" role="tab" aria-selected="false" data-analytics-topic="routes">
                    <span class="material-symbols-outlined" aria-hidden="true">route</span>
                    <span data-i18n="statistics_topic_routes">Routes</span>
                </button>
                <button type="button" role="tab" aria-selected="false" data-analytics-topic="services">
                    <span class="material-symbols-outlined" aria-hidden="true">train</span>
                    <span data-i18n="statistics_topic_services">Train services</span>
                </button>
                <button type="button" role="tab" aria-selected="false" data-analytics-topic="quality">
                    <span class="material-symbols-outlined" aria-hidden="true">fact_check</span>
                    <span data-i18n="statistics_topic_quality">Data quality</span>
                </button>
            </nav>

            <section class="statistics-performance-grid statistics-performance-grid-wide" data-analytics-topic-panel="overview">
                <article class="statistics-panel statistics-analytics-panel">
                    <div class="statistics-panel-head">
                        <div>
                            <span class="statistics-panel-kicker" data-i18n="statistics_punctuality_standard">Punctuality standard</span>
                            <h2 data-i18n="statistics_punctuality_trend">Arrival punctuality trend</h2>
                        </div>
                        <span class="statistics-chart-unit">%</span>
                    </div>
                    <div id="statisticsPunctualityTrendChart" class="statistics-echart" role="img" aria-label="Arrival punctuality trend"></div>
                    <div id="statisticsPunctualityTrendTable" class="statistics-chart-data-table"></div>
                </article>

                <article class="statistics-panel statistics-analytics-panel">
                    <div class="statistics-panel-head">
                        <div>
                            <span class="statistics-panel-kicker" data-i18n="statistics_delay_distribution">Distribution, not only averages</span>
                            <h2 data-i18n="statistics_delay_percentiles">Arrival delay percentiles</h2>
                        </div>
                        <span class="statistics-chart-unit" data-i18n="statistics_minutes_short">min</span>
                    </div>
                    <div id="statisticsDelayPercentileChart" class="statistics-echart" role="img" aria-label="Arrival delay percentiles"></div>
                    <div id="statisticsDelayPercentileTable" class="statistics-chart-data-table"></div>
                </article>
            </section>

            <section class="statistics-performance-grid" data-analytics-topic-panel="overview">
                <article class="statistics-panel statistics-analytics-panel">
                    <div class="statistics-panel-head">
                        <div>
                            <span class="statistics-panel-kicker" data-i18n="statistics_current_window">Current window</span>
                            <h2 data-i18n="statistics_delay_buckets">Arrival delay distribution</h2>
                        </div>
                    </div>
                    <div id="statisticsDelayDistributionChart" class="statistics-echart statistics-echart-compact" role="img" aria-label="Arrival delay distribution"></div>
                </article>
                <article class="statistics-panel statistics-analytics-panel">
                    <div class="statistics-panel-head">
                        <div>
                            <span class="statistics-panel-kicker" data-i18n="statistics_long_tail">Long-tail disruption</span>
                            <h2 data-i18n="statistics_severe_delay_share">Severe arrival delay share</h2>
                        </div>
                    </div>
                    <div id="statisticsSevereDelayChart" class="statistics-echart statistics-echart-compact" role="img" aria-label="Severe delay share"></div>
                </article>
                <article class="statistics-panel statistics-analytics-panel">
                    <div class="statistics-panel-head">
                        <div>
                            <span class="statistics-panel-kicker" data-i18n="statistics_daily_consistency">Daily consistency</span>
                            <h2 data-i18n="statistics_punctuality_calendar">Punctuality calendar</h2>
                        </div>
                    </div>
                    <div id="statisticsPunctualityCalendarChart" class="statistics-echart statistics-echart-compact" role="img" aria-label="Daily punctuality calendar"></div>
                </article>
            </section>

            <section class="statistics-dashboard-topic" data-analytics-topic-panel="mix" hidden>
                <div class="statistics-performance-grid statistics-performance-grid-wide">
                    <article class="statistics-panel statistics-analytics-panel">
                        <div class="statistics-panel-head">
                            <div>
                                <span class="statistics-panel-kicker" data-i18n="statistics_observed_service_share">Observed service share</span>
                                <h2 data-i18n="statistics_operator_mix">Operator mix</h2>
                            </div>
                            <span id="statisticsActiveOperators" class="statistics-chart-unit">--</span>
                        </div>
                        <div id="statisticsOperatorMixChart" class="statistics-echart" role="img" aria-label="Observed service share by operator"></div>
                        <div id="statisticsOperatorMixTable" class="statistics-chart-data-table"></div>
                    </article>
                    <article class="statistics-panel statistics-analytics-panel">
                        <div class="statistics-panel-head">
                            <div>
                                <span class="statistics-panel-kicker" data-i18n="statistics_observed_service_share">Observed service share</span>
                                <h2 data-i18n="statistics_category_mix">Category mix</h2>
                            </div>
                        </div>
                        <div id="statisticsCategoryMixChart" class="statistics-echart" role="img" aria-label="Observed service share by category"></div>
                        <div id="statisticsCategoryMixTable" class="statistics-chart-data-table"></div>
                    </article>
                </div>
                <article class="statistics-panel statistics-analytics-panel statistics-dashboard-full">
                    <div class="statistics-panel-head">
                        <div>
                            <span class="statistics-panel-kicker" data-i18n="statistics_cross_dimension">Cross-dimension composition</span>
                            <h2 data-i18n="statistics_operator_category_matrix">Operator × category matrix</h2>
                        </div>
                    </div>
                    <p class="statistics-method-note" data-i18n="statistics_mix_scope_note">Shares describe distinct observable services, not passengers, seats or market share.</p>
                    <div id="statisticsOperatorCategoryChart" class="statistics-echart statistics-echart-matrix" role="img" aria-label="Operator and category matrix"></div>
                    <div id="statisticsOperatorCategoryTable" class="statistics-chart-data-table"></div>
                </article>
            </section>

            <section class="statistics-dashboard-topic" data-analytics-topic-panel="rhythm" hidden>
                <div class="statistics-performance-grid statistics-performance-grid-wide">
                    <article class="statistics-panel statistics-analytics-panel statistics-dashboard-wide-panel">
                        <div class="statistics-panel-head">
                            <div>
                                <span class="statistics-panel-kicker" data-i18n="statistics_scheduled_service_pattern">Scheduled service pattern</span>
                                <h2 data-i18n="statistics_weekday_hour_heatmap">Weekday × departure hour</h2>
                            </div>
                        </div>
                        <div id="statisticsNetworkRhythmChart" class="statistics-echart statistics-echart-heatmap" role="img" aria-label="Observed departures by weekday and hour"></div>
                        <div id="statisticsNetworkRhythmTable" class="statistics-chart-data-table"></div>
                    </article>
                    <article class="statistics-panel statistics-analytics-panel">
                        <div class="statistics-panel-head">
                            <div>
                                <span class="statistics-panel-kicker" data-i18n="statistics_category_profiles">Category profiles</span>
                                <h2 data-i18n="statistics_hourly_category_profile">Hourly category profile</h2>
                            </div>
                        </div>
                        <div id="statisticsCategoryRhythmChart" class="statistics-echart statistics-echart-heatmap" role="img" aria-label="Hourly service profile by category"></div>
                        <div id="statisticsCategoryRhythmTable" class="statistics-chart-data-table"></div>
                    </article>
                </div>
            </section>

            <section class="statistics-dashboard-topic" data-analytics-topic-panel="stations" hidden>
                <div class="statistics-network-layout">
                    <article class="statistics-panel statistics-analytics-panel statistics-station-ranking-panel">
                        <div class="statistics-panel-head">
                            <div>
                                <span class="statistics-panel-kicker" data-i18n="statistics_station_activity">Distinct observed services</span>
                                <h2 data-i18n="statistics_busiest_stations">Busiest observed stations</h2>
                            </div>
                        </div>
                        <p class="statistics-method-note" data-i18n="statistics_station_volume_note">Repeated 30-minute observations are deduplicated; this is not passenger footfall.</p>
                        <div id="statisticsStationLeaderboard" class="statistics-leaderboard" aria-live="polite"></div>
                    </article>
                    <article class="statistics-panel statistics-analytics-panel">
                        <div class="statistics-panel-head">
                            <div>
                                <span class="statistics-panel-kicker" data-i18n="statistics_scale_quality">Scale and quality</span>
